# ENIGMA environment (copy to .env; never commit real secrets)

# PostgreSQL (schema in db/migrations/) — pgvector optional for now
DATABASE_URL=postgresql://enigma:enigma@localhost:5432/enigma

# LLM gateway — provider-independent by design. Interpretation only, never calculation.
# Leave blank in the POC; the Canon engine needs no model.
ENIGMA_LLM_PROVIDER=
ENIGMA_LLM_MODEL=
ENIGMA_LLM_API_KEY=

# Restricted-content providers are NOT wired up in this scaffold.
# A lyrics adapter must sit behind the rights engine before any key is added here.
# MUSIXMATCH_API_KEY=
# LYRICFIND_API_KEY=
